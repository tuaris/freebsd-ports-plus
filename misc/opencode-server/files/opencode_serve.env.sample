# OpenCode server environment, sourced by the opencode_serve rc script.
# Every VAR= line is auto-exported (set -a) into the daemon environment.
# Keep secrets here rather than in rc.conf, which is world-readable.
#
# HTTP basic auth password for the server (username 'opencode'). Strongly
# advised whenever opencode_serve_hostname is not 127.0.0.1.
#OPENCODE_SERVER_PASSWORD=change-me
#
# Provider API keys used by the agent, for example:
#ANTHROPIC_API_KEY=
#OPENAI_API_KEY=
