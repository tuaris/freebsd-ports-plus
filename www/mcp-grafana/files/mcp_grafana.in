#!/bin/sh

# PROVIDE: mcp_grafana
# REQUIRE: LOGIN NETWORKING
# KEYWORD: shutdown

# Add the following lines to /etc/rc.conf to enable mcp_grafana:
#
# mcp_grafana_enable (bool):
#     Set it to YES to enable mcp_grafana.
#     Set to NO by default.
# mcp_grafana_user (str):
#     User the server runs as.
#     Default is "%%USERS%%".
# mcp_grafana_group (str):
#     Group the server runs as.
#     Default is "%%GROUPS%%".
# mcp_grafana_env_file (str):
#     File rc.subr sources as root before the privileges are dropped. Its
#     variables are exported to the server, so GRAFANA_URL and the tokens
#     belong here (keep it mode 0600). It is skipped when it is not readable.
#     Default is "%%PREFIX%%/etc/mcp_grafana.env".
# mcp_grafana_flags (str):
#     Additional mcp-grafana arguments, for example
#     "--address 0.0.0.0:8443 --allowed-hosts mcp.example.com:8443".
#     Without --address the server listens on localhost:8000 only.
#     Default is "".
#
# The server logs to syslog (daemon facility).

. /etc/rc.subr

name=mcp_grafana
rcvar=mcp_grafana_enable

load_rc_config $name

: ${mcp_grafana_enable:="NO"}
: ${mcp_grafana_user:="%%USERS%%"}
: ${mcp_grafana_group:="%%GROUPS%%"}
: ${mcp_grafana_env_file:="%%PREFIX%%/etc/mcp_grafana.env"}

pidfile="/var/run/${name}/${name}.pid"

procname="%%PREFIX%%/bin/mcp-grafana"
command="/usr/sbin/daemon"
command_args="-f -S -T ${name} -p ${pidfile} \
	${procname} -t streamable-http ${mcp_grafana_flags}"

start_precmd="mcp_grafana_precmd"

mcp_grafana_precmd()
{
	install -d -m 0750 -o ${mcp_grafana_user} -g ${mcp_grafana_group} \
		"/var/run/${name}"

	# mcp_grafana_flags is for mcp-grafana and is already part of
	# command_args; rc.subr would otherwise also hand it to daemon(8).
	rc_flags=""
}

run_rc_command "$1"
