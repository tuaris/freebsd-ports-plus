# Environment for the mcp_grafana service. rc.subr sources this file as root,
# then drops to mcp_grafana_user, so it may be root-only (mode 0600). Copy this
# sample to mcp_grafana.env and edit it.

# The Grafana instance the server talks to.
GRAFANA_URL=http://127.0.0.1:3000

# Service account token used when a client does not send its own. Prefer
# leaving this unset and letting each client send X-Grafana-Service-Account-Token
# so Grafana attributes requests to the caller. Create the account with only
# the permissions the tools need.
#GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Require "Authorization: Bearer <token>" from every client of this server.
# Strongly recommended whenever the server listens on a non-loopback address.
#MCP_GRAFANA_SERVER_TOKEN=

# Upstream reports anonymous usage statistics to Grafana Labs unless disabled.
GRAFANA_USAGE_STATS=disabled
