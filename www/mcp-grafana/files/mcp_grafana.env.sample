# Environment for the mcp_grafana service, sourced by rc.subr as root before the
# server starts as mcp_grafana_user. Copy this sample to mcp_grafana.env and
# edit it. Keep the file mode 0600.

# The Grafana instance the server talks to.
GRAFANA_URL=http://localhost:3000

# Service account token used when a client does not send its own in
# X-Grafana-Service-Account-Token. Leaving it unset makes every client bring
# its own, so Grafana attributes requests to the caller.
#GRAFANA_SERVICE_ACCOUNT_TOKEN=

# Require "Authorization: Bearer <token>" from every client of this server.
#MCP_GRAFANA_SERVER_TOKEN=

# Upstream reports anonymous usage statistics unless this is disabled.
GRAFANA_USAGE_STATS=disabled
